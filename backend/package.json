{
  "name": "marvel-comic-backend",
  "version": "1.0.0",
  "description": "Backend API for Marvel Comic Platform (Nhom 10)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "seed:cv": "node scripts/seedFromComicVine.js",
    "test": "node tests/checkReadAccess.test.js && node tests/paymentTransaction.test.js && node tests/sprint4Features.test.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "colorthief": "^3.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.12.0",
    "node-vibrant": "^4.0.4",
    "sequelize": "^6.37.5",
    "slugify": "^1.6.9",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "sequelize-cli": "^6.6.2"
  }
}
